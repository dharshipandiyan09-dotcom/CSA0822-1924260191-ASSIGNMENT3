trains = { 
    "101": { 
        "name": "Chennai Express", 
        "stops": [ 
            ("Chennai", "08:00", "08:10"), 
            ("Katpadi", "10:00", "10:05"), 
            ("Bangalore", "12:00", "12:10") 
        ], 
        "days": {"Mon", "Wed", "Fri"} 
    }, 
    "102": { 
        "name": "Coimbatore Express", 
        "stops": [ 
            ("Chennai", "09:00", "09:15"), 
            ("Salem", "12:00", "12:05") 
        ], 
        "days": {"Tue", "Thu"} 

    }, 
    "103": { 
        "name": "Pandian Express", 
        "stops": [ 
            ("Madurai", "07:00", "07:10"), 
            ("Chennai", "11:00", "11:10") 
        ], 
        "days": {"Mon", "Tue", "Fri"} 
    }, 
    "104": { 
        "name": "Mysore Express", 
        "stops": [ 
            ("Chennai", "06:00", "06:10"), 
            ("Katpadi", "08:00", "08:05") 
        ], 
        "days": {"Wed", "Sat"} 
    }, 
    "105": { 
        "name": "Salem Express", 
        "stops": [ 
            ("Salem", "10:00", "10:10"), 
            ("Chennai", "14:00", "14:10") 
        ], 
        "days": {"Mon", "Sun"} 
    } 
} 
station = "Chennai" 
day = "Mon" 
# Create station index 
index = {} 
for number, train in trains.items(): 
    for stop in train["stops"]: 
        index.setdefault(stop[0], []).append(number) 
# Search and sort trains 
results = [] 
for number in index.get(station, []): 
    train = trains[number] 
    if day in train["days"]: 
        for stop in train["stops"]: 
            if stop[0] == station: 
                results.append( 
                    (stop[2], number, train["name"]) 
                ) 
results.sort() 
print("Station:", station) 
print("Running Day:", day) 
print("Available Trains:") 
for departure, number, name in results: 
    print(number, name, "Departure:", departure) 
print("Indexed Trains:", index[station]) 

