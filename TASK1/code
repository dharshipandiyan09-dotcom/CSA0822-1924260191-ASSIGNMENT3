import random 
readings = [random.randint(0, 20) for _ in range(365)] 
# Weekly totals 
weekly_totals = [ 
    sum(readings[i:i+7]) 
    for i in range(0, 365, 7) 
] 
print("Weekly Totals:", weekly_totals) 
# Maximum and minimum 
print("Maximum Rainfall:", max(readings)) 
print("Maximum Day:", readings.index(max(readings)) + 1) 
print("Minimum Rainfall:", min(readings)) 
print("Minimum Day:", readings.index(min(readings)) + 1) 
# 7-day moving average 
moving_avg = [ 
    sum(readings[i:i+7]) / 7 
    for i in range(len(readings) - 6) 
] 
print("First 7-day Moving Average:", round(moving_avg[0], 2)) 
# Dry days 
dry_days = [i+1 for i, x in enumerate(readings) if x == 0] 
print("Dry Days:", dry_days) 
